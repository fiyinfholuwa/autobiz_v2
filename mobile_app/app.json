{
  "expo": {
    "name": "AutoBiz",
    "slug": "autobiz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.autobiz.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#299d91"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.autobiz.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoBiz needs photo access to upload gift card images and documents.",
          "cameraPermission": "AutoBiz needs camera access to snap gift card images."
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "scheme": "autobiz",
    "experiments": {
      "typedRoutes": false
    }
  }
}
